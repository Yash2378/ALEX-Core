---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { REPO, REPO_PUBLIC } from '../lib/repo.js';
const {
  title = 'Deep Pearl AI',
  description = 'Deep Pearl AI is an independent research lab studying AI evaluation: blind peer evaluation of frontier models, and whether the judges grading them can be trusted.',
  ogType = 'website',
  chapter = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/multivac', label: 'Multivac' },
  { href: '/partialcredit', label: 'PartialCredit' },
  { href: '/superintelligence', label: 'Superintelligence' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080a" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..600,0..100,0..1&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&display=swap"
    />

    <meta property="og:site_name" content="Deep Pearl AI" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Deep Pearl AI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Deep Pearl AI" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" transition:persist="header">
      <div class="wrap">
        <a href="/" class="wordmark" aria-label="Deep Pearl AI home">
          <span class="pearl" aria-hidden="true"></span>
          <span>Deep Pearl AI</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      {chapter && <span class="ghost-num" aria-hidden="true">{chapter}</span>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="wordmark" aria-label="Deep Pearl AI home">
              <span class="pearl" aria-hidden="true"></span>
              <span>Deep Pearl AI</span>
            </a>
            <p>
              An independent research lab. Evaluation you can trust, and judges
              you can check.
            </p>
          </div>
          <div class="footer-col">
            <h4>Lab</h4>
            <ul>
              <li><a href="/multivac">Multivac</a></li>
              <li><a href="/partialcredit">PartialCredit</a></li>
              <li><a href="/superintelligence">Superintelligence</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Elsewhere</h4>
            <ul>
              <li><a href="https://themultivac.com" rel="noopener">themultivac.com</a></li>
              <li><a href="https://app.themultivac.com" rel="noopener">app.themultivac.com</a></li>
              {REPO_PUBLIC && <li><a href={REPO} rel="noopener">partial-credit-judge</a></li>}
              <li><a href="https://github.com/Yash2378" rel="noopener">github.com/Yash2378</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <span>Deep Pearl AI · Independent research</span>
          <span>deeppearlai.com</span>
        </div>
      </div>
    </footer>
    <script>
      import { initPage } from '../lib/nacre.js';

      // The header is transition:persist-ed, so a client-side navigation keeps
      // the old header and drops the incoming page's server-rendered
      // aria-current. Re-derive it from the URL with the frontmatter's rule.
      // astro:after-swap fires after the URL changes and inside the view
      // transition's update, so the new frame never shows a stale underline.
      function syncNavCurrent() {
        const path = location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll('.site-nav a').forEach((a) => {
          if (a.getAttribute('href') === path) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      }

      document.addEventListener('astro:after-swap', syncNavCurrent);
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>

<style is:global>
  /* Three nav labels (Superintelligence is the longest). On phones the header
     wraps the nav onto a row of its own: viewport minus the 20px gutters, which
     on narrow phones is less than the 347px the labels take at 12.5px. From
     400px down, tighten size, tracking and gaps so all three show in full
     instead of scrolling out of view (288px of labels, 275px at 340px and below). */
  @media (max-width: 400px) {
    .site-header .site-nav {
      gap: 10px;
      font-size: 11px;
      letter-spacing: 0.04em;
    }
  }

  @media (max-width: 340px) {
    .site-header .site-nav {
      gap: 8px;
      letter-spacing: 0.02em;
    }
  }
</style>
