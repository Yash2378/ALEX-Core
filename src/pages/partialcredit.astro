<script>
  import { pearlLUT, lutColor, makeSim, glowSprite, reducedMotion } from '../lib/nacre.js';

  function initPartialCreditPage() {
    const canvas = document.getElementById('pc-canvas');
    if (!canvas || canvas.dataset.init) return;
    canvas.dataset.init = '1';

    /* ---------------- constants ---------------- */
    const A_PASS = 806; /* README example: patch A passes 806 of ~1000 hidden inputs */
    const TOTAL = 1000;
    const HUE_A = 0.02; /* pearl-a, cool */
    const HUE_B = 0.36; /* pearl-b, warm */
    const INK = (a) => `rgba(233,230,223,${a})`;
    const ALERT = (a) => `rgba(216,160,122,${a})`; /* --alert: inversion only */
    const RED = (a) => `rgba(194,69,47,${a})`; /* --press-red: withheld apparatus only */
    const STRATA = [
      { name: 'near_tie', lo: 0, hi: 50 },
      { name: 'small', lo: 50, hi: 150 },
      { name: 'medium', lo: 150, hi: 350 },
      { name: 'large', lo: 350, hi: 700 },
      { name: 'huge', lo: 700, hi: 1000 },
    ];
    /* strata are (lo, hi] on |rate(A) - rate(B)|, in thousandths */
    const stratumIndex = (gk) => (gk <= 0 ? -1 : STRATA.findIndex((s) => gk <= s.hi));
    const DUR = { score: 2200, pair: 1500, judge: 2600, verdict: 2000, hold: 2800, unpaired: 2600 };
    const OUTCOME_INV = 'INVERSION — JUDGE PICKED THE PATCH EXECUTION RANKS LOWER';
    const OUTCOME_OK = 'AGREES WITH EXECUTION';
    const outcomeBoth = (vs) => vs.map((v) => `${v.order.toUpperCase()}: ${v.inversion ? 'INVERSION' : 'AGREES'}`).join(' · ');
    const OUTCOME_BOTH_LONGEST = outcomeBoth([{ order: 'hi_first', inversion: true }, { order: 'lo_first', inversion: true }]);
    /* the still's verdict slot shows both outcomes of the order it presents */
    const STILL_HI_AS_A = 'A → agrees with execution · B → inversion';
    const STILL_HI_AS_B = 'A → inversion · B → agrees with execution';

    const lut = pearlLUT(undefined, 256, 2.3);
    const lutRGB = (t) => lut[((Math.floor(t * lut.length) % lut.length) + lut.length) % lut.length];
    const spriteA = glowSprite(lutRGB(HUE_A), 48, 0.9);
    const spriteB = glowSprite(lutRGB(HUE_B), 48, 0.9);
    const coinSprite = glowSprite([240, 238, 232], 64, 0.7);

    /* ---------------- DOM ---------------- */
    const $ = (id) => document.getElementById(id);
    const plate = $('pc-plate');
    /* under reduced motion the plate only ever shows the composed still (renderStill) */
    plate.classList.toggle('still', reducedMotion);
    const el = {
      labA: $('pc-lab-a'),
      labB: $('pc-lab-b'),
      countA: $('pc-count-a'),
      countB: $('pc-count-b'),
      gaplab: $('pc-gaplab'),
      rellab: $('pc-rellab'),
      whA: $('pc-wh-a'),
      whB: $('pc-wh-b'),
      striplab: $('pc-striplab'),
      snames: Array.from(document.querySelectorAll('#pc-stratum-names .pc-sname')),
      sbounds: Array.from(document.querySelectorAll('#pc-stratum-bounds .pc-sbound')),
      orderlab: $('pc-orderlab'),
      card1: $('pc-card-1'),
      card2: $('pc-card-2'),
      cardlab1: $('pc-cardlab-1'),
      cardlab2: $('pc-cardlab-2'),
      v1: $('pc-verdict-1'),
      v2: $('pc-verdict-2'),
      coinlab: $('pc-coinlab'),
      outcome: $('pc-outcome'),
      phase: $('pc-phase'),
      roHi: $('pc-ro-hi'),
      roLo: $('pc-ro-lo'),
      roGap: $('pc-ro-gap'),
      roStratum: $('pc-ro-stratum'),
      roOrder: $('pc-ro-order'),
      roRel: $('pc-ro-rel'),
      roVerdict: $('pc-ro-verdict'),
      roOutcome: $('pc-ro-outcome'),
      run: $('pc-run'),
      gap: $('pc-gap'),
      gapOut: $('pc-gap-out'),
      orders: $('pc-orders'),
      relation: $('pc-relation'),
      relationVal: $('pc-relation-val'),
      hint: $('pc-hint'),
    };

    /* ---------------- state ---------------- */
    const S = {
      gapK: 315, /* thousandths; B = A_PASS - gapK */
      bothOrders: false,
      crossed: false,
      N: 100,
      trial: 0,
      order: 'hi_first',
      phase: 'score',
      phaseT: 0,
      simT: 0,
      a: null, /* Uint8Array(N): 1 = passes that hidden input */
      b: null,
      colT: null, /* Float64Array(cols): simT when the scan resolved that column */
      resolvedCols: 0,
      mask: 0, /* 0..1 — rows withheld while the judge card is up */
      verdicts: [], /* one per presented order: { order, slot, patch, inversion } */
      cardsShown: false,
      stampsShown: false,
      exclusive: 0, /* cells B passes that A fails (crossed only) */
    };
    const bPass = () => A_PASS - S.gapK;
    const rateA = () => A_PASS / TOTAL;
    const rateB = () => bPass() / TOTAL;
    const paired = () => S.gapK > 0;

    /* seeded xorshift for the pass pattern; the coin uses Math.random and nothing else */
    let seed = 0x2f6e2b1;
    const rand = () => {
      seed ^= seed << 13;
      seed ^= seed >>> 17;
      seed ^= seed << 5;
      seed >>>= 0;
      return seed / 4294967296;
    };
    const shuffle = (arr) => {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = (rand() * (i + 1)) | 0;
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    };
    const clamp01 = (v) => Math.max(0, Math.min(1, v));
    /* the still's verdict slots, card 1 then card 2 */
    const stillVerdicts = (both) => (both ? [STILL_HI_AS_A, STILL_HI_AS_B] : [S.order === 'hi_first' ? STILL_HI_AS_A : STILL_HI_AS_B]);
    const easeOut = (t) => 1 - Math.pow(1 - t, 3);

    function makePattern() {
      const N = S.N;
      const aCount = Math.round(rateA() * N);
      const bCount = Math.round(rateB() * N);
      const idx = shuffle(Array.from({ length: N }, (_, i) => i));
      const a = new Uint8Array(N);
      const b = new Uint8Array(N);
      const aPass = shuffle(idx.slice(0, aCount));
      const aFail = shuffle(idx.slice(aCount));
      aPass.forEach((i) => (a[i] = 1));
      let excl = 0;
      if (S.crossed && aFail.length && bCount > 0) {
        excl = Math.min(aFail.length, bCount, Math.max(1, Math.round(bCount * 0.3)));
      }
      for (let k = 0; k < excl; k++) b[aFail[k]] = 1;
      for (let k = 0; k < bCount - excl; k++) b[aPass[k]] = 1;
      S.a = a;
      S.b = b;
      S.exclusive = excl;
    }

    /* ---------------- geometry (CSS px) ---------------- */
    let G = null;
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

    /* the card's height is read from the DOM: it drives the vertical budget */
    function measureCard(width, variant) {
      for (const c of [el.card1, el.card2]) {
        c.classList.toggle('tight', variant === 'tight');
        c.classList.toggle('micro', variant === 'micro');
        c.style.width = `${Math.round(width)}px`;
      }
      return el.card1.offsetHeight || 170;
    }

    /* the still's cards at a width and face, measured with the verdict text they show
       (both outcomes, not the animation's "_"): the taller of the two orders' texts when
       both cards are up; the live text is put back */
    function measureStillCards(width, variant, both) {
      const keep = el.v1.textContent;
      let h = 0;
      for (const text of stillVerdicts(both)) {
        el.v1.textContent = text;
        h = Math.max(h, measureCard(width, variant));
      }
      el.v1.textContent = keep;
      return h;
    }

    /* the outcome's height at a width for a given text; the live text is put back */
    function measureOutcome(width, text) {
      const o = el.outcome;
      const keepText = o.textContent;
      const keepClass = o.className;
      const keepWidth = o.style.width;
      o.className = 'plate-label pc-outcome left';
      o.style.width = `${Math.round(width)}px`;
      o.textContent = text;
      const h = o.offsetHeight || 30;
      o.textContent = keepText;
      o.className = keepClass;
      o.style.width = keepWidth;
      return h;
    }

    function geometry(view) {
      const { W } = view;
      const compact = W < 620;
      const two = S.bothOrders;
      /* compact-only card styles must apply before the card is measured */
      plate.classList.toggle('compact', compact);
      const pad = compact ? 14 : 30;
      const labelW = compact ? 0 : 96;
      const countW = compact ? 0 : 86;
      const cols = compact ? 25 : 50;
      const lines = Math.max(1, Math.round(S.N / cols));
      const bandX = pad + labelW;
      const availW = Math.max(40, W - bandX - pad - countW);
      const pitch = Math.min(compact ? 11 : 18, availW / cols);
      const bandW = cols * pitch;
      const cell = pitch * 0.72;
      const bandH = lines * pitch;
      const rowLabelH = compact ? 15 : 0;
      const stripH = compact ? 12 : 16;
      const segGap = 3;
      const segW = (bandW - segGap * 4) / 5;
      const coinR = compact ? 13 : 20;
      const g = {
        W, compact, two, pad, labelW, countW, cols, lines, bandX, bandW, pitch, cell, bandH,
        rowLabelH, stripH, segGap, segW, coinR,
      };
      /* compact rows: one column, each row's label and count above its band */
      const compactRows = () => {
        g.aY = 32 + rowLabelH; /* the verdict frame encloses the row label and stays under the top labels */
        g.aEnd = g.aY + bandH;
        g.barAY = g.aEnd + 6;
        g.bracketY = g.barAY + 12;
        g.barBY = g.bracketY + 12;
        g.bY = g.barBY + 6 + rowLabelH;
        g.bEnd = g.bY + bandH;
      };

      if (!compact) {
        /* the card and the coin share the lower zone; a gap unit u stretches or
           compresses the stack so one whole trial fits the plate's height, with
           fixed clearances where HTML labels meet (bounds 16px above the strip,
           names 23px under it, the order label 19px above the cards) */
        const coinZoneW = Math.round(W * 0.3);
        const cardsW = W - pad * 2 - coinZoneW - 10;
        const cardWFor = (both) => (both ? (cardsW - 12) / 2 : Math.min(cardsW, 420));
        /* fitted to the stylesheet's height, not to a height set below, so the
           result never feeds back into itself */
        const H = naturalHeight(view);
        const stack = (u, tight, cardH) => {
          const s = { u };
          s.aY = 34 + 0.7 * u;
          s.aEnd = s.aY + bandH;
          s.barAY = s.aEnd + 0.5 * u;
          s.bracketY = s.barAY + 1.1 * u;
          s.barBY = s.bracketY + 1.1 * u;
          s.bY = s.barBY + 0.5 * u;
          s.bEnd = s.bY + bandH;
          /* labels are ~18px tall (body line-height): the relation label under row B
             needs 40px before the bound labels (tight plates drop it), and the names
             under the strip need 44px before the order label above the cards */
          s.stripY = s.bEnd + Math.max(2.9 * u, tight ? 24 : 40);
          s.lowY = s.stripY + stripH + Math.max(2.75 * u, 44);
          s.bottom = s.lowY + cardH + 40; /* the phase label row, clear of the card's 6px slide as it fades */
          return s;
        };
        const fit = (tight, cardH, uMin = 8) => {
          let u = clamp((H - 68 - 2 * bandH - stripH - cardH) / 9.55, uMin, 22);
          let s = stack(u, tight, cardH);
          while (s.bottom > H && u > uMin) {
            u = Math.max(uMin, u - 0.5);
            s = stack(u, tight, cardH);
          }
          return s;
        };
        /* the card face and row spacing for one order mode, tightest last */
        const plan = (both) => {
          const cardW = cardWFor(both);
          let tight = false;
          let cardH = measureCard(cardW, '');
          let s = fit(tight, cardH);
          if (s.bottom > H) {
            tight = true;
            cardH = measureCard(cardW, both ? 'micro' : 'tight');
            s = fit(tight, cardH);
          }
          if (s.bottom > H && !both) {
            /* the shortest 16/9 plates (just above the 1:1 switch): the single
               card takes the micro face too, so it clears the phase label */
            cardH = measureCard(cardW, 'micro');
            s = fit(tight, cardH);
          }
          if (s.bottom > H) {
            /* row spacing below its usual floor (7 keeps the gap label clear of
               the lo bar) */
            s = fit(tight, cardH, 7);
          }
          return { s, tight, cardW, cardH };
        };
        /* the other mode first, so the cards keep the faces of the one in use */
        const alt = plan(!two);
        const cur = plan(two);
        /* last resort, met by the reduced-motion still with both orders just above
           the 1:1 switch: if even the tightest stack overruns the plate, the plate
           grows to the taller mode's stack, so a toggle never resizes it */
        const need = Math.max(cur.s.bottom, alt.s.bottom);
        setPlateHeight(need > H + 0.5 ? need + (plate.offsetHeight - plate.clientHeight) : 0);
        const { s, tight, cardW, cardH } = cur;
        Object.assign(g, s);
        g.tight = tight;
        g.cardW = cardW;
        g.cardH = cardH;
        g.cardX1 = pad;
        g.cardX2 = pad + cardW + 12;
        g.cardY = g.lowY;
        g.labelY = g.lowY - 19; /* order and card labels sit above the cards */
        const coinCX = W - pad - coinZoneW / 2;
        g.coinXs = two ? [coinCX - coinR * 1.5, coinCX + coinR * 1.5] : [coinCX];
        g.coinCY = g.lowY + coinR + 6;
        g.outcomeX = coinCX;
        g.outcomeY = g.coinCY + coinR + 12;
        g.outcomeW = coinZoneW - 6;
        g.outcomeLeft = false;
      } else if (reducedMotion) {
        /* compact still: nothing animates, so a card laid over the rows would never
           lift off them. The rows, the bracket and the strip read in full, then the
           order label (or the two cards' labels) and the card (or the two micro cards
           side by side) under the strip names, then the phase label. */
        const cardW1 = W - pad * 2;
        const cardW2 = (W - pad * 2 - 6) / 2;
        /* measure the other order mode first, so the cards keep the faces of the one in use */
        const otherH = two ? measureStillCards(cardW1, 'tight', false) : measureStillCards(cardW2, 'micro', true);
        const cardW = two ? cardW2 : cardW1;
        const cardH = measureStillCards(cardW, two ? 'micro' : 'tight', two);
        g.tight = true;
        compactRows();
        g.stripY = g.bEnd + 22; /* STRATUM label sits 15px above the strip */
        g.labelY = g.stripY + stripH + 30; /* the names sit 4px under the strip, ~14px tall */
        g.cardY = g.labelY + 19; /* the order and card labels sit above the cards */
        /* Height budget: the taller order mode's cards, then the phase label row along
           the bottom edge. Phones grow the plate past its square to fit, and a toggle
           never resizes it. */
        const phaseRow = 10 + (el.phase.offsetHeight || 16) + 14;
        const need = Math.ceil(g.cardY + Math.max(cardH, otherH) + phaseRow);
        setPlateHeight(need > W + 0.5 ? need + (plate.offsetHeight - plate.clientHeight) : 0);
        g.cardW = cardW;
        g.cardH = cardH;
        g.cardX1 = pad;
        g.cardX2 = pad + cardW + 6;
        /* no coin and no outcome in the still: their row sits under the cards, empty */
        g.lowY = g.cardY + cardH + 10;
        g.coinXs = [pad + coinR];
        g.coinCY = g.lowY + coinR + 2;
        g.outcomeX = pad;
        g.outcomeY = g.lowY + 2;
        g.outcomeW = W - pad * 2;
        g.outcomeLeft = true;
      } else {
        /* compact: the card overlays the withheld rows (their labels hide under it);
           the order label sits under the card, then the strip, then a short lower
           zone where the coin and the outcome share one row */
        const cardW1 = W - pad * 2;
        const cardW2 = (W - pad * 2 - 6) / 2;
        /* measure the other order mode first, so the cards keep the faces of the one in use */
        const otherH = two ? measureCard(cardW1, 'tight') : measureCard(cardW2, 'micro');
        const cardW = two ? cardW2 : cardW1;
        const cardH = measureCard(cardW, two ? 'micro' : 'tight');
        g.tight = true;
        compactRows();
        g.cardY = g.aY - rowLabelH + 14;
        const x0 = pad + coinR;
        const coinXsFor = (both) => (both ? [x0, x0 + coinR * 2 + 6] : [x0]);
        const outcomeXFor = (both) => coinXsFor(both)[both ? 1 : 0] + coinR + 10;
        /* the stack under a card of height h: order label (clear of the card's 6px
           slide as it fades), strip, then the coin row */
        const stackFor = (h) => {
          const labelY = g.cardY + h + 8;
          const stripY = Math.max(g.bEnd + 22, labelY + 32); /* STRATUM label sits 15px above the strip */
          return { labelY, stripY, lowY: stripY + stripH + 24 };
        };
        /* Height budget. The stack is fixed from the top, so on the narrowest phones
           a square plate is too short for it. The plate then grows to the taller of
           the two order modes, so a toggle never resizes it: the card, the coin row
           (coin and inversion ring, or the longest outcome), then the phase label
           row along the bottom edge. */
        const rowBottom = (h, both) => {
          const outH = measureOutcome(W - pad - outcomeXFor(both), both ? OUTCOME_BOTH_LONGEST : OUTCOME_INV);
          return stackFor(h).lowY + 2 + Math.max(coinR * 2 + 6, outH);
        };
        const phaseRow = 6 + (el.phase.offsetHeight || 16) + 14;
        const need = Math.ceil(Math.max(rowBottom(cardH, two), rowBottom(otherH, !two)) + phaseRow);
        setPlateHeight(need > W + 0.5 ? need + (plate.offsetHeight - plate.clientHeight) : 0);
        const st = stackFor(cardH);
        g.cardW = cardW;
        g.cardH = cardH;
        g.cardX1 = pad;
        g.cardX2 = pad + cardW + 6;
        g.labelY = st.labelY;
        g.stripY = st.stripY;
        g.lowY = st.lowY;
        g.coinXs = coinXsFor(two);
        g.coinCY = g.lowY + coinR + 2;
        g.outcomeX = outcomeXFor(two);
        g.outcomeY = g.lowY + 2;
        g.outcomeW = W - pad - g.outcomeX;
        g.outcomeLeft = true;
      }
      return g;
    }

    /* An explicit plate height (border box) when the plate is too short for its
       stack (see the height budgets in geometry), or 0 for the stylesheet's aspect
       ratio. The ratio is dropped while a height is set: a ratio with a min-height
       would widen the plate past its column. */
    function setPlateHeight(px) {
      const h = px ? `${Math.ceil(px)}px` : '';
      const ar = px ? 'auto' : '';
      if (plate.style.height !== h) plate.style.height = h;
      if (plate.style.aspectRatio !== ar) plate.style.aspectRatio = ar;
    }

    /* the plate's inner height under the stylesheet alone (its aspect ratio) */
    function naturalHeight(view) {
      const h = plate.style.height;
      if (!h) return view.H;
      const ar = plate.style.aspectRatio;
      plate.style.height = '';
      plate.style.aspectRatio = '';
      const natural = plate.clientHeight;
      plate.style.height = h;
      plate.style.aspectRatio = ar;
      return natural;
    }

    const place = (node, left, top, width) => {
      node.style.left = `${Math.round(left)}px`;
      node.style.top = `${Math.round(top)}px`;
      if (width != null) node.style.width = `${Math.round(width)}px`;
    };
    const cellX = (i) => G.bandX + (i % G.cols) * G.pitch + (G.pitch - G.cell) / 2;
    const cellY = (bandY, i) => bandY + Math.floor(i / G.cols) * G.pitch + (G.pitch - G.cell) / 2;
    const xHi = () => G.bandX + rateA() * G.bandW;
    const xLo = () => G.bandX + rateB() * G.bandW;

    function layoutDom() {
      const g = G;
      plate.classList.toggle('compact', g.compact);
      plate.classList.toggle('tight', g.tight);
      if (g.compact) {
        place(el.labA, g.bandX, g.aY - g.rowLabelH - 1);
        place(el.labB, g.bandX, g.bY - g.rowLabelH - 1);
        place(el.countA, g.bandX + g.bandW - 70, g.aY - g.rowLabelH - 1, 70);
        place(el.countB, g.bandX + g.bandW - 70, g.bY - g.rowLabelH - 1, 70);
        el.countA.style.textAlign = 'right';
        el.countB.style.textAlign = 'right';
        place(el.striplab, g.bandX, g.stripY - 15);
      } else {
        place(el.labA, g.pad, g.aY + g.bandH / 2 - 8);
        place(el.labB, g.pad, g.bY + g.bandH / 2 - 8);
        place(el.countA, g.bandX + g.bandW + 14, g.aY + g.bandH / 2 - 8);
        place(el.countB, g.bandX + g.bandW + 14, g.bY + g.bandH / 2 - 8);
        el.countA.style.textAlign = '';
        el.countB.style.textAlign = '';
        el.countA.style.width = '';
        el.countB.style.width = '';
        place(el.striplab, g.pad, g.stripY + g.stripH / 2 - 8);
      }
      place(el.rellab, g.bandX, g.bEnd + 6);
      placeGapLabel();
      el.snames.forEach((n, i) => place(n, g.bandX + i * (g.segW + g.segGap) + g.segW / 2, g.stripY + g.stripH + (g.compact ? 4 : 7)));
      el.sbounds.forEach((n, i) => {
        const x = i === 5 ? g.bandX + g.bandW : g.bandX + i * (g.segW + g.segGap) - (i ? g.segGap / 2 : 0);
        place(n, x, g.stripY - 16);
      });

      /* judge cards and their annotations */
      place(el.card1, g.cardX1, g.cardY);
      place(el.card2, g.cardX2, g.cardY);
      place(el.cardlab1, g.cardX1, g.labelY);
      place(el.cardlab2, g.cardX2, g.labelY);
      setOrderLabel();
      place(el.orderlab, g.cardX1, g.labelY);

      /* withheld stamps sit on the rows (not shown on compact, where the card covers them) */
      place(el.whA, g.bandX + g.bandW / 2, g.aY + g.bandH / 2);
      place(el.whB, g.bandX + g.bandW / 2, g.bY + g.bandH / 2);

      /* coin zone: the outcome, then the null caption */
      el.outcome.classList.toggle('left', g.outcomeLeft);
      place(el.outcome, g.outcomeX, g.outcomeY, g.outcomeW);
      const outH = el.outcome.offsetHeight || 30;
      place(el.coinlab, g.outcomeX, g.outcomeY + outH + 8, g.outcomeW);
      el.coinlab.style.transform = g.outcomeLeft ? 'none' : 'translateX(-50%)';
      el.coinlab.style.whiteSpace = 'normal';
      el.coinlab.style.textAlign = g.outcomeLeft ? 'left' : 'center';
      el.coinlab.style.lineHeight = '1.5';

      /* the phase label keeps the layout's gutter: in line with the row labels */
      el.phase.style.left = `${g.pad}px`;
    }

    /* the gap label rides the bracket, so it moves whenever the gap does (every
       startTrial and still frame, through setStratumDom), not only on a relayout;
       a shown label is also held inside the plate's padding, which only the
       long gap-0 label on the narrowest plates needs */
    function placeGapLabel() {
      if (!G) return;
      const half = el.gaplab.offsetWidth / 2; /* 0 while hidden: placed again when shown */
      place(el.gaplab, clamp((xLo() + xHi()) / 2, G.pad + half, G.W - G.pad - half), G.bracketY - 7);
    }

    function relayout() {
      if (!sim) return;
      G = geometry(sim.view);
      layoutDom();
    }

    /* ---------------- HTML state ---------------- */
    const fmt = (n) => n.toLocaleString('en-US');
    function setCounts(kA, kB) {
      el.countA.innerHTML = `<strong>${fmt(kA)}</strong>&thinsp;/&thinsp;${fmt(TOTAL)}`;
      el.countB.innerHTML = `<strong>${fmt(kB)}</strong>&thinsp;/&thinsp;${fmt(TOTAL)}`;
    }
    let lastCounts = '';
    function updateCounts(progress) {
      const kA = Math.round(A_PASS * progress);
      const kB = Math.round(bPass() * progress);
      const key = `${kA}/${kB}`;
      if (key === lastCounts) return;
      lastCounts = key;
      setCounts(kA, kB);
    }
    function setPhaseLabel(text) {
      if (el.phase.textContent !== text) el.phase.textContent = text;
    }
    function setStratumDom() {
      const idx = stratumIndex(S.gapK);
      el.snames.forEach((n, i) => n.classList.toggle('lit', i === idx && S.phase !== 'score'));
      el.roStratum.textContent = idx < 0 ? 'none' : STRATA[idx].name;
      el.gaplab.textContent = idx < 0 ? 'GAP 0 · NEVER PAIRED' : `GAP ${(S.gapK / 1000).toFixed(3)}`;
      placeGapLabel();
    }
    /* the single-order label; compact plates get the short form, as with the phase label */
    let orderHtml = null;
    function setOrderLabel() {
      let html = '';
      if (!S.bothOrders && paired()) {
        const hi = S.order === 'hi_first';
        html = G && G.compact
          ? hi ? 'ORDER &middot; HI_FIRST &middot; A SHOWN AS A' : 'ORDER &middot; LO_FIRST &middot; A SHOWN AS B'
          : hi ? 'ORDER &middot; HI_FIRST &middot; PATCH A SHOWN AS CANDIDATE A' : 'ORDER &middot; LO_FIRST &middot; PATCH A SHOWN AS CANDIDATE B';
      }
      if (html !== orderHtml) {
        orderHtml = html;
        el.orderlab.innerHTML = html;
      }
      el.orderlab.hidden = !html;
    }
    function setStaticReadouts() {
      /* equal pass rates are never paired: no relation, no order, no judge call */
      const isPair = paired();
      el.roHi.textContent = fmt(A_PASS);
      el.roLo.textContent = fmt(bPass());
      el.roGap.textContent = (S.gapK / 1000).toFixed(3);
      el.roRel.textContent = !isPair ? '—' : S.crossed ? 'crossed' : 'nested';
      el.roOrder.textContent = !isPair ? '—' : S.bothOrders ? 'both' : S.order;
      el.rellab.innerHTML = S.crossed
        ? `CROSSED &middot; B PASSES ${S.exclusive} CELL${S.exclusive === 1 ? '' : 'S'} A FAILS &middot; &ldquo;BETTER&rdquo; IS ONLY A COUNT`
        : 'NESTED &middot; B &sub; A &middot; AN INVERSION HERE IS UNAMBIGUOUSLY AN ERROR';
      el.rellab.hidden = !isPair;
      setOrderLabel();
      el.cardlab1.hidden = !S.bothOrders || !isPair;
      el.cardlab2.hidden = !S.bothOrders || !isPair;
      el.card2.hidden = !S.bothOrders;
      el.hint.textContent = paired()
        ? `A is fixed at ${fmt(A_PASS)}; the slider moves B`
        : 'Equal pass rates are never paired';
      setStratumDom();
    }
    function showCards(on) {
      if (S.cardsShown === on) return;
      S.cardsShown = on;
      el.card1.classList.toggle('up', on);
      el.card2.classList.toggle('up', on);
      /* .cardup: the compact animation's card is over the rows (the still's never is) */
      plate.classList.toggle('cardup', on && !reducedMotion);
    }
    function showStamps(on) {
      if (S.stampsShown === on) return;
      S.stampsShown = on;
      const hide = !on || (G && G.compact);
      el.whA.hidden = hide;
      el.whB.hidden = hide;
    }
    function clearVerdictDom() {
      el.v1.textContent = '_';
      el.v2.textContent = '_';
      el.roVerdict.textContent = '_';
      el.roOutcome.textContent = '—';
      el.outcome.textContent = '';
      el.outcome.className = 'plate-label pc-outcome';
      el.coinlab.hidden = true;
    }

    /* ---------------- trial lifecycle ---------------- */
    const LAND = 1100; /* ms into the verdict phase when the coin settles */
    let sim = null;

    /* The verdict is a fair coin per presented order. It never reads the gap. */
    function drawVerdicts() {
      const orders = S.bothOrders ? ['hi_first', 'lo_first'] : [S.order];
      S.verdicts = orders.map((order) => {
        const slot = Math.random() < 0.5 ? 'A' : 'B';
        const patch = (order === 'hi_first') === (slot === 'A') ? 'hi' : 'lo';
        return { order, slot, patch, inversion: patch === 'lo', landed: false };
      });
    }

    function phaseLabelFor(phase) {
      const c = G && G.compact;
      switch (phase) {
        case 'score': return c ? '01 SCORING' : '01 SCORING · EVERY CANDIDATE RUNS ON EVERY HIDDEN INPUT';
        case 'pair': return c ? '02 PAIRING' : '02 PAIRING · GAP = |RATE(A) − RATE(B)| → STRATUM';
        case 'judge': return c ? '03 JUDGING · WITHHELD' : '03 JUDGING · TESTS AND PASS RATES WITHHELD';
        case 'verdict': return c ? '04 VERDICT · FAIR COIN' : '04 VERDICT · A FAIR COIN AT THE NULL, 0.50';
        case 'hold': return c ? '04 VERDICT · FAIR COIN' : '04 VERDICT · A FAIR COIN AT THE NULL, 0.50';
        case 'unpaired': return c ? 'NEVER PAIRED AT GAP 0' : 'EQUAL PASS RATES ARE NEVER PAIRED · NO JUDGE CALL';
        default: return '';
      }
    }

    function startTrial(quick) {
      const keepScan = quick && S.phase !== 'score' && S.a;
      if (!quick) S.trial++;
      if (!S.bothOrders && !quick) S.order = S.trial % 2 ? 'hi_first' : 'lo_first';
      const wantN = sim && sim.view.degraded ? 50 : 100;
      if (wantN !== S.N) {
        S.N = wantN;
        if (sim) {
          G = geometry(sim.view);
          layoutDom();
        }
      }
      seed = ((0x9e3779b9 ^ Math.imul(S.trial + 1, 0x85ebca6b)) >>> 0) || 1;
      makePattern();
      S.colT = new Float64Array(G ? G.cols : 1).fill(-1e9);
      S.resolvedCols = 0;
      S.mask = 0;
      S.verdicts = [];
      showCards(false);
      showStamps(false);
      clearVerdictDom();
      S.phaseT = 0;
      lastCounts = '';
      if (keepScan) {
        /* the rows are already scored: go straight to pairing, or to the
           never-paired notice when the slider sits at gap 0 */
        S.phase = paired() ? 'pair' : 'unpaired';
        S.resolvedCols = G.cols;
        updateCounts(1);
      } else {
        S.phase = 'score';
        updateCounts(0);
      }
      el.gaplab.hidden = true;
      setStaticReadouts();
      setPhaseLabel(phaseLabelFor(S.phase));
    }

    function advance(dt) {
      S.phaseT += dt;
      const next = (phase) => {
        S.phase = phase;
        S.phaseT = 0;
        setPhaseLabel(phaseLabelFor(phase));
      };
      switch (S.phase) {
        case 'score':
          if (S.phaseT >= DUR.score + 320) next(paired() ? 'pair' : 'unpaired');
          break;
        case 'pair':
          if (!paired()) {
            next('unpaired'); /* equal pass rates are never paired: no judge call */
            break;
          }
          if (S.phaseT >= DUR.pair) {
            drawVerdicts();
            next('judge');
            showCards(true);
          }
          break;
        case 'judge':
          if (S.phaseT >= DUR.judge) next('verdict');
          break;
        case 'verdict':
          if (S.phaseT >= DUR.verdict) next('hold');
          break;
        case 'hold':
          if (S.phaseT >= DUR.hold) startTrial(false);
          break;
        case 'unpaired':
          if (S.phaseT >= DUR.unpaired) startTrial(false);
          break;
      }
    }

    function landDom() {
      S.verdicts.forEach((v, k) => ((k === 0 ? el.v1 : el.v2).textContent = v.slot));
      el.roVerdict.textContent = S.verdicts.map((v) => v.slot).join(' · ');
      el.roOutcome.textContent = S.verdicts.map((v) => (v.inversion ? 'inversion' : 'agrees')).join(' · ');
      const anyInv = S.verdicts.some((v) => v.inversion);
      el.outcome.textContent = S.bothOrders ? outcomeBoth(S.verdicts) : anyInv ? OUTCOME_INV : OUTCOME_OK;
      el.outcome.className = `plate-label pc-outcome ${anyInv ? 'inv' : 'ok'}`;
      el.coinlab.hidden = false;
      layoutDom();
    }

    /* ---------------- drawing ---------------- */
    function drawBand(ctx, bandY, vec, hue, sprite, isB) {
      const g = G;
      const dim = 1 - 0.8 * S.mask;
      const resolved = S.resolvedCols;
      /* unresolved cells: a faint registration dot */
      ctx.fillStyle = INK(0.1);
      for (let i = 0; i < S.N; i++) {
        if (i % g.cols < resolved) continue;
        const x = cellX(i);
        const y = cellY(bandY, i);
        ctx.fillRect(x + g.cell / 2 - 1, y + g.cell / 2 - 1, 2, 2);
      }
      /* passes: filled with the patch's LUT colour */
      ctx.fillStyle = lutColor(lut, hue, 0.86 * dim);
      for (let i = 0; i < S.N; i++) {
        if (i % g.cols >= resolved || !vec[i]) continue;
        ctx.fillRect(cellX(i), cellY(bandY, i), g.cell, g.cell);
      }
      /* crossed pairs: B passes an input A fails — hollow centre */
      if (isB && S.crossed) {
        ctx.fillStyle = `rgba(4,5,10,${0.9 * dim})`;
        for (let i = 0; i < S.N; i++) {
          if (i % g.cols >= resolved || !vec[i] || S.a[i]) continue;
          const x = cellX(i);
          const y = cellY(bandY, i);
          ctx.fillRect(x + g.cell * 0.32, y + g.cell * 0.32, g.cell * 0.36, g.cell * 0.36);
        }
      }
      /* fails: hollow with an x */
      ctx.strokeStyle = INK(0.3 * dim);
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i < S.N; i++) {
        if (i % g.cols >= resolved || vec[i]) continue;
        const x = cellX(i);
        const y = cellY(bandY, i);
        const c = g.cell;
        ctx.rect(x + 0.5, y + 0.5, c - 1, c - 1);
        ctx.moveTo(x + 2, y + 2);
        ctx.lineTo(x + c - 2, y + c - 2);
        ctx.moveTo(x + c - 2, y + 2);
        ctx.lineTo(x + 2, y + c - 2);
      }
      ctx.stroke();
      /* fresh resolves glow for a beat — pre-rendered sprites, no shadowBlur */
      if (S.colT) {
        ctx.globalCompositeOperation = 'lighter';
        for (let i = 0; i < S.N; i++) {
          const col = i % g.cols;
          if (col >= resolved || !vec[i]) continue;
          const age = S.simT - S.colT[col];
          if (age > 280) continue;
          ctx.globalAlpha = (1 - age / 280) * 0.55;
          const x = cellX(i) + g.cell / 2;
          const y = cellY(bandY, i) + g.cell / 2;
          ctx.drawImage(sprite, x - g.cell * 1.3, y - g.cell * 1.3, g.cell * 2.6, g.cell * 2.6);
        }
        ctx.globalAlpha = 1;
        ctx.globalCompositeOperation = 'source-over';
      }
      /* withheld: the only use of press-red on this plate */
      if (S.mask > 0.01) {
        const m = S.mask;
        ctx.fillStyle = `rgba(4,5,10,${0.5 * m})`;
        ctx.fillRect(g.bandX - 5, bandY - 5, g.bandW + 10, g.bandH + 10);
        ctx.strokeStyle = RED(0.6 * m);
        ctx.strokeRect(g.bandX - 4.5, bandY - 4.5, g.bandW + 9, g.bandH + 9);
        ctx.beginPath();
        ctx.moveTo(g.bandX - 4, bandY - 4);
        ctx.lineTo(g.bandX + g.bandW + 4, bandY + g.bandH + 4);
        ctx.strokeStyle = RED(0.35 * m);
        ctx.stroke();
      }
    }

    function drawPairing(ctx, pairP) {
      const g = G;
      const hi = xHi();
      const lo = xLo();
      const barP = easeOut(clamp01(pairP / 600));
      ctx.fillStyle = INK(0.08);
      ctx.fillRect(g.bandX, g.barAY - 1, g.bandW, 2);
      ctx.fillRect(g.bandX, g.barBY - 1, g.bandW, 2);
      ctx.fillStyle = lutColor(lut, HUE_A, 0.9);
      ctx.fillRect(g.bandX, g.barAY - 1, (hi - g.bandX) * barP, 2);
      ctx.fillStyle = lutColor(lut, HUE_B, 0.9);
      ctx.fillRect(g.bandX, g.barBY - 1, (lo - g.bandX) * barP, 2);
      const brP = easeOut(clamp01((pairP - 500) / 450));
      if (brP > 0) {
        ctx.strokeStyle = INK(0.7 * brP);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(Math.round(hi) + 0.5, g.barAY + 2);
        ctx.lineTo(Math.round(hi) + 0.5, g.bracketY + 0.5);
        ctx.moveTo(Math.round(lo) + 0.5, g.barBY - 2);
        ctx.lineTo(Math.round(lo) + 0.5, g.bracketY + 0.5);
        ctx.moveTo(lo, g.bracketY + 0.5);
        ctx.lineTo(lo + (hi - lo) * brP, g.bracketY + 0.5);
        ctx.stroke();
      }
      const showGap = brP >= 0.5;
      if (el.gaplab.hidden === showGap) {
        el.gaplab.hidden = !showGap;
        if (showGap) placeGapLabel();
      }
      return easeOut(clamp01((pairP - 900) / 500));
    }

    function drawStrip(ctx, litP) {
      const g = G;
      const idx = stratumIndex(S.gapK);
      for (let i = 0; i < 5; i++) {
        const x = g.bandX + i * (g.segW + g.segGap);
        const lit = i === idx && litP > 0;
        const hue = 0.05 + i * 0.17;
        ctx.fillStyle = lit ? lutColor(lut, hue, 0.12 + 0.4 * litP) : INK(0.035);
        ctx.fillRect(x, g.stripY, g.segW, g.stripH);
        ctx.strokeStyle = lit ? lutColor(lut, hue, 0.5 + 0.4 * litP) : INK(0.16);
        ctx.strokeRect(Math.round(x) + 0.5, g.stripY + 0.5, Math.round(g.segW) - 1, g.stripH - 1);
        if (lit) {
          const s = STRATA[i];
          const px = x + ((S.gapK - s.lo) / (s.hi - s.lo)) * g.segW;
          ctx.fillStyle = INK(0.9 * litP);
          ctx.fillRect(Math.round(px) - 0.5, g.stripY - 4, 1, g.stripH + 8);
        }
      }
      const lit = idx >= 0 && litP > 0.3;
      el.snames.forEach((n, i) => {
        const want = lit && i === idx;
        if (n.classList.contains('lit') !== want) n.classList.toggle('lit', want);
      });
    }

    function drawCoins(ctx, vt) {
      const g = G;
      const flipT = clamp01(vt / LAND);
      const n = S.verdicts.length;
      S.verdicts.forEach((v, k) => {
        const cx = g.coinXs[Math.min(k, g.coinXs.length - 1)];
        const lift = Math.sin(Math.PI * Math.min(1, flipT)) * g.coinR * 1.4;
        const cy = g.coinCY - lift;
        const th = easeOut(flipT) * Math.PI * 7 + k * 0.9;
        let hue;
        let rx;
        if (flipT < 0.92) {
          hue = Math.cos(th) >= 0 ? HUE_A : HUE_B;
          rx = Math.max(1.5, Math.abs(Math.cos(th)) * g.coinR);
        } else {
          hue = v.patch === 'hi' ? HUE_A : HUE_B;
          rx = g.coinR * (0.92 + 0.08 * ((flipT - 0.92) / 0.08));
        }
        ctx.globalCompositeOperation = 'lighter';
        ctx.globalAlpha = flipT >= 1 ? 0.3 : 0.18;
        ctx.drawImage(coinSprite, cx - g.coinR * 1.9, cy - g.coinR * 1.9, g.coinR * 3.8, g.coinR * 3.8);
        ctx.globalAlpha = 1;
        ctx.globalCompositeOperation = 'source-over';
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, g.coinR, 0, 0, Math.PI * 2);
        ctx.fillStyle = lutColor(lut, hue, 0.92);
        ctx.fill();
        ctx.strokeStyle = INK(0.55);
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx * 0.68, g.coinR * 0.68, 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(4,5,10,0.45)';
        ctx.stroke();
        if (flipT >= 1 && v.inversion) {
          ctx.beginPath();
          ctx.ellipse(cx, cy, g.coinR + 5, g.coinR + 5, 0, 0, Math.PI * 2);
          ctx.strokeStyle = ALERT(0.9);
          ctx.lineWidth = 1.5;
          ctx.stroke();
          ctx.lineWidth = 1;
        }
      });
    }

    function drawOutcomeFrames(ctx, alpha) {
      const g = G;
      if (alpha <= 0) return;
      S.verdicts.forEach((v) => {
        const y = v.inversion ? g.bY : g.aY;
        /* compact plates carry the row label above the band: the frame encloses it */
        const top = g.compact ? y - g.rowLabelH - 3.5 : y - 6.5;
        const bottom = y + g.bandH + 6.5;
        ctx.strokeStyle = v.inversion ? ALERT(0.9 * alpha) : INK(0.5 * alpha);
        ctx.lineWidth = 1;
        ctx.strokeRect(g.bandX - 6.5, top, g.bandW + 13, bottom - top);
        const t = 10;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(g.bandX - 6, top + 0.5 + t);
        ctx.lineTo(g.bandX - 6, top + 0.5);
        ctx.lineTo(g.bandX - 6 + t, top + 0.5);
        ctx.moveTo(g.bandX + g.bandW + 6 - t, bottom - 0.5);
        ctx.lineTo(g.bandX + g.bandW + 6, bottom - 0.5);
        ctx.lineTo(g.bandX + g.bandW + 6, bottom - 0.5 - t);
        ctx.stroke();
        ctx.lineWidth = 1;
      });
    }

    function render(ctx, t, dt, view) {
      if (!G) {
        G = geometry(view);
        layoutDom();
      }
      if (!S.a) startTrial(false);
      S.simT += dt;
      advance(dt);
      const g = G;
      ctx.clearRect(0, 0, view.W, view.H);

      /* phase 1: the scan line resolves columns as it passes them */
      if (S.phase === 'score') {
        const scanX = g.bandX + clamp01(S.phaseT / DUR.score) * (g.bandW + g.pitch);
        while (S.resolvedCols < g.cols && g.bandX + S.resolvedCols * g.pitch + g.pitch / 2 <= scanX) {
          S.colT[S.resolvedCols] = S.simT;
          S.resolvedCols++;
        }
        updateCounts(S.resolvedCols / g.cols);
      }

      /* withheld mask follows the judge card */
      const cardUp = S.phase === 'judge' || (S.phase === 'verdict' && S.phaseT < LAND);
      const target = cardUp ? 1 : 0;
      S.mask += (target - S.mask) * (1 - Math.exp(-dt / 130));
      if (Math.abs(S.mask - target) < 0.01) S.mask = target;
      showStamps(S.mask > 0.5);
      /* on a compact plate the card covers the rows, so it leaves when the coin
         lands and the chosen row's frame takes over */
      if (g.compact && !cardUp && S.phase !== 'judge') showCards(false);

      drawBand(ctx, g.aY, S.a, HUE_A, spriteA, false);
      drawBand(ctx, g.bY, S.b, HUE_B, spriteB, true);

      if (S.phase === 'score') {
        const scanX = g.bandX + clamp01(S.phaseT / DUR.score) * (g.bandW + g.pitch);
        if (scanX <= g.bandX + g.bandW + 2) {
          const grad = ctx.createLinearGradient(scanX - 42, 0, scanX, 0);
          grad.addColorStop(0, lutColor(lut, HUE_A, 0));
          grad.addColorStop(1, lutColor(lut, HUE_A, 0.16));
          ctx.fillStyle = grad;
          ctx.fillRect(scanX - 42, g.aY - 6, 42, g.bEnd - g.aY + 12);
          ctx.fillStyle = INK(0.6);
          ctx.fillRect(Math.round(scanX), g.aY - 8, 1, g.bEnd - g.aY + 16);
        }
      }

      let litP = 0;
      if (S.phase === 'pair' || S.phase === 'unpaired') litP = drawPairing(ctx, S.phaseT);
      else if (S.phase !== 'score') litP = drawPairing(ctx, 1e5);
      drawStrip(ctx, litP);

      if (S.phase === 'verdict' || S.phase === 'hold') {
        const vt = S.phase === 'verdict' ? S.phaseT : 1e5;
        if (vt >= LAND && S.verdicts.length && !S.verdicts[0].landed) {
          S.verdicts.forEach((v) => (v.landed = true));
          landDom();
        }
        drawCoins(ctx, vt);
        drawOutcomeFrames(ctx, clamp01((vt - LAND) / 300));
      }
    }

    /* composed still: both rows scored, bracket, lit stratum, the card with both outcomes */
    function renderStill(ctx, view) {
      /* the verdict slots first, so the layout measures the cards as they read */
      if (paired()) {
        const [v1, v2 = STILL_HI_AS_B] = stillVerdicts(S.bothOrders);
        el.v1.textContent = v1;
        el.v2.textContent = v2;
      }
      G = geometry(view);
      layoutDom();
      if (!S.a) makePattern();
      S.resolvedCols = G.cols;
      S.colT = new Float64Array(G.cols).fill(-1e9);
      S.mask = 0;
      S.phase = paired() ? 'hold' : 'unpaired';
      ctx.clearRect(0, 0, view.W, view.H);
      drawBand(ctx, G.aY, S.a, HUE_A, spriteA, false);
      drawBand(ctx, G.bY, S.b, HUE_B, spriteB, true);
      drawStrip(ctx, drawPairing(ctx, 1e5));
      /* HTML side of the still */
      setCounts(A_PASS, bPass());
      el.gaplab.hidden = false;
      setStaticReadouts();
      showStamps(false);
      el.coinlab.hidden = true;
      el.outcome.textContent = '';
      el.outcome.className = 'plate-label pc-outcome';
      if (paired()) {
        el.roVerdict.textContent = 'A | B';
        el.roOutcome.textContent = 'agrees | inversion';
        showCards(true);
        setPhaseLabel(G.compact ? 'STILL · NO COIN' : 'STILL · ONE TRIAL FULLY SCORED · BOTH OUTCOMES SHOWN, NO COIN');
      } else {
        showCards(false);
        el.roVerdict.textContent = '_';
        el.roOutcome.textContent = '—';
        setPhaseLabel(phaseLabelFor('unpaired'));
      }
    }

    sim = makeSim(canvas, {
      init: (view) => {
        const prevCols = G ? G.cols : 0;
        G = geometry(view);
        layoutDom();
        if (!reducedMotion && S.a && prevCols && prevCols !== G.cols) startTrial(S.phase !== 'score');
        if (!reducedMotion && S.a) setPhaseLabel(phaseLabelFor(S.phase));
      },
      render,
      renderStill,
    });
    if (!reducedMotion) startTrial(false);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        /* the mono font changes the card's measured height, so re-budget */
        relayout();
        if (reducedMotion) sim.restart();
      });
    }

    /* ---------------- controls ---------------- */
    function restartQuick() {
      if (reducedMotion) {
        makePattern();
        sim.restart();
        return;
      }
      startTrial(true);
    }
    el.run.addEventListener('click', () => {
      if (reducedMotion) {
        S.trial++;
        seed = ((0x9e3779b9 ^ Math.imul(S.trial + 1, 0x85ebca6b)) >>> 0) || 1;
        makePattern();
        sim.restart();
        return;
      }
      startTrial(false);
    });
    el.gap.addEventListener('input', () => {
      const v = Math.round(Number(el.gap.value) / 5) * 5;
      S.gapK = Math.max(0, Math.min(800, v));
      el.gapOut.textContent = (S.gapK / 1000).toFixed(3);
      restartQuick();
    });
    el.orders.addEventListener('click', () => {
      S.bothOrders = !S.bothOrders;
      el.orders.setAttribute('aria-pressed', String(S.bothOrders));
      el.card2.hidden = !S.bothOrders;
      relayout();
      restartQuick();
    });
    el.relation.addEventListener('click', () => {
      S.crossed = !S.crossed;
      el.relation.setAttribute('aria-pressed', String(S.crossed));
      el.relationVal.textContent = S.crossed ? 'crossed' : 'nested';
      restartQuick();
    });
  }

  document.addEventListener('astro:page-load', initPartialCreditPage);
</script>
