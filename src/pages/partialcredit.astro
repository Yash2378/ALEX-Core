---
import Layout from '../layouts/Layout.astro';
import { REPO, REPO_PUBLIC } from '../lib/repo.js';

const BLOB = `${REPO}/blob/main`;

/* "Read the source": linked while the repository is public, named by path while it is private */
const SOURCES = [
  { path: 'docs/PREREGISTRATION.md', href: `${BLOB}/docs/PREREGISTRATION.md`, note: 'frozen v1, 2026-10-23, tag prereg-v1' },
  { path: 'docs/DECISIONS.md', href: `${BLOB}/docs/DECISIONS.md`, note: 'decisions log' },
  { path: 'docs/proposal-v2.md', href: `${BLOB}/docs/proposal-v2.md`, note: 'original proposal, history only' },
  { path: 'configs/models.yaml', href: `${BLOB}/configs/models.yaml`, note: 'panel, generators, profiles, strata' },
  { path: 'partialcredit/prompts.py', href: `${BLOB}/partialcredit/prompts.py`, note: 'the judge prompt' },
  { path: 'data/analysis/pilot/', href: `${REPO}/tree/main/data/analysis/pilot`, note: 'pilot artifacts: report, sizing, glmer, no-op' },
];

/* Judge panel in configs/models.yaml order — never ordered by any score. */
const JUDGES = [
  { slug: 'openai/gpt-5', note: 'reasoning: low' },
  { slug: 'anthropic/claude-sonnet-4.5', note: '' },
  { slug: 'google/gemini-2.5-pro', note: 'reasoning: low' },
  { slug: 'deepseek/deepseek-chat-v3.1', note: '' },
  { slug: 'cohere/command-a', note: 'replaced z-ai/glm-4.6, amendment 2' },
  { slug: 'moonshotai/kimi-k2-0905', note: 'max_tokens 10,000' },
  { slug: 'google/gemma-3-12b-it', note: 'small · contrast row', small: true },
  { slug: 'openai/gpt-4o-mini', note: 'small · contrast row', small: true },
];

const GENERATORS = [
  { slug: 'meta-llama/llama-3.1-8b-instruct', note: '' },
  { slug: 'qwen/qwen-2.5-7b-instruct', note: '' },
  { slug: 'meta-llama/llama-3.2-3b-instruct', note: '' },
  { slug: 'microsoft/phi-4', note: '' },
  { slug: 'qwen/qwen3-14b', note: 'replaced qwen/qwen3-8b, amendment 8' },
  { slug: 'mistralai/mistral-small-3.2-24b-instruct', note: '' },
  { slug: 'meta-llama/llama-3.3-70b-instruct', note: 'mid-size reserve, only if pair yield is short; unused so far' },
];

const STRATA = [
  { name: 'near_tie', range: '(0, 0.05]' },
  { name: 'small', range: '(0.05, 0.15]' },
  { name: 'medium', range: '(0.15, 0.35]' },
  { name: 'large', range: '(0.35, 0.70]' },
  { name: 'huge', range: '(0.70, 1.0]' },
];

const AMENDMENTS = [
  ['2026-10-23', 'GLM-4.6 reasoning settings and token caps; a new "truncated" abstention status.'],
  ['2026-10-23', 'z-ai/glm-4.6 replaced by cohere/command-a; panel stays at 8 judges.'],
  ['2026-10-23', 'Planted no-op stratum rule corrected (47 of 124 pilot no-op pairs affected; headline unaffected).'],
  ['2026-10-23', 'K = 3 for the full run (its sizing figures withdrawn by amendment 9; K = 3 stands).'],
  ['2026-10-23', 'Exclusion rule 5: tasks whose expected-output payload exceeds 50 MB.'],
  ['2026-10-23', 'Second MBPP+ seeding pass with amazon/nova-micro-v1.'],
  ['2026-10-23', 'Nested vs crossed secondary analysis; hi_contains_lo bug fixed.'],
  ['2026-10-23', 'Pre-full-run code review, eight fixes.'],
  ['2026-10-26', 'Clustering corrected from (judge, task) to task; sizing redone; task-cluster bootstrap CIs (B = 5000); strata pooled only if the realised near-tie MDE is at or under 10 points.'],
];
---
<Layout
  title="PartialCredit · Deep Pearl AI"
  description="PartialCredit asks whether LLM judges rank partially-correct code fixes the way hidden tests do: pairs of partly-right patches, scored by execution, judged blind by a preregistered panel."
  chapter="02"
>
  <section class="page-hero">
    <div class="wrap">
      <a class="back" href="/">
        <span aria-hidden="true">&larr;</span>
        <span>Deep Pearl AI</span>
      </a>
      <div class="meta-row">
        <p class="eyebrow"><span class="bar" aria-hidden="true"></span>Judge audit</p>
        <span class="tag tag-active pc-status-tag"><span>Pilot&nbsp;complete&nbsp;&middot; <span class="pc-nobr">preregistered 2026-10-23</span></span></span>
      </div>
      <h1>PartialCredit</h1>
      <p class="pc-thesis">Do LLM judges rank partially-correct code fixes the way hidden tests do?</p>
      <p class="lede">
        Teams increasingly let one language model grade the code another one
        wrote, because asking a model is cheaper than running the tests.
        PartialCredit builds pairs of bug fixes that are both partly right
        &mdash; each passes some of a hidden test suite, neither passes all of
        it &mdash; shows them to a panel of LLM judges blind, and measures how
        often the judge prefers the fix that execution says is worse, and
        whether that rate climbs as the two fixes get closer in quality.
      </p>
      <div class="hero-links">
        {REPO_PUBLIC ? (
          <>
            <a class="btn btn-primary" href={REPO} rel="noopener">GitHub repository</a>
            <a class="btn" href={`${BLOB}/docs/PREREGISTRATION.md`} rel="noopener">Read the preregistration</a>
          </>
        ) : (
          <span class="tag">Repository not yet public</span>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <figure class="figure" data-accrete>
        <div class="plate pc-plate" id="pc-plate">
          <canvas id="pc-canvas" aria-hidden="true"></canvas>

          <span class="plate-label" style="top:14px;left:30px">ONE TRIAL &middot; SCHEMATIC</span>
          <span class="plate-label pc-lab-inputs" style="top:14px;right:30px">100 CELLS STAND FOR ONE TASK&rsquo;S HIDDEN INPUTS</span>

          <span class="plate-label pc-rowlab" id="pc-lab-a">PATCH A</span>
          <span class="plate-label pc-rowlab" id="pc-lab-b">PATCH B</span>
          <span class="plate-label pc-count" id="pc-count-a"><strong>806</strong>&thinsp;/&thinsp;1000</span>
          <span class="plate-label pc-count" id="pc-count-b"><strong>491</strong>&thinsp;/&thinsp;1000</span>
          <span class="plate-label pc-gaplab" id="pc-gaplab">GAP 0.315</span>
          <span class="plate-label pc-rel" id="pc-rellab">NESTED &middot; B&rsquo;S PASSES &sub; A&rsquo;S</span>
          <span class="plate-label red pc-withheld" id="pc-wh-a" hidden>WITHHELD</span>
          <span class="plate-label red pc-withheld" id="pc-wh-b" hidden>WITHHELD</span>

          <span class="plate-label pc-striplab" id="pc-striplab">STRATUM</span>
          <div class="pc-stratum-names" id="pc-stratum-names" aria-hidden="true">
            {STRATA.map((s) => <span class="plate-label pc-sname" data-stratum={s.name}>{s.name.replace('_', ' ')}</span>)}
          </div>
          <div class="pc-stratum-bounds" id="pc-stratum-bounds" aria-hidden="true">
            {['0', '0.05', '0.15', '0.35', '0.70', '1.0'].map((b) => <span class="plate-label pc-sbound">{b}</span>)}
          </div>

          <span class="plate-label pc-orderlab" id="pc-orderlab">ORDER &middot; HI_FIRST &middot; PATCH A SHOWN AS CANDIDATE A</span>

          <div class="pc-card" id="pc-card-1" aria-label="What the judge sees">
            <p class="pc-card-h">What the judge sees</p>
            <ul class="pc-card-list">
              <li><span>specification</span><i aria-hidden="true"></i></li>
              <li><span>buggy program</span><i aria-hidden="true"></i></li>
              <li><span>candidate A</span><i aria-hidden="true"></i></li>
              <li><span>candidate B</span><i aria-hidden="true"></i></li>
            </ul>
            <p class="pc-card-note">never tests, never pass rates, never model names</p>
            <p class="pc-card-verdict">VERDICT: <strong id="pc-verdict-1">_</strong></p>
          </div>
          <div class="pc-card" id="pc-card-2" aria-label="What the judge sees, other order" hidden>
            <p class="pc-card-h">What the judge sees</p>
            <ul class="pc-card-list">
              <li><span>specification</span><i aria-hidden="true"></i></li>
              <li><span>buggy program</span><i aria-hidden="true"></i></li>
              <li><span>candidate A</span><i aria-hidden="true"></i></li>
              <li><span>candidate B</span><i aria-hidden="true"></i></li>
            </ul>
            <p class="pc-card-note">never tests, never pass rates, never model names</p>
            <p class="pc-card-verdict">VERDICT: <strong id="pc-verdict-2">_</strong></p>
          </div>
          <span class="plate-label pc-cardlab" id="pc-cardlab-1" hidden>HI SHOWN AS A</span>
          <span class="plate-label pc-cardlab" id="pc-cardlab-2" hidden>HI SHOWN AS B</span>

          <span class="plate-label pc-coinlab" id="pc-coinlab">FAIR COIN &middot; SIMULATED AT THE NULL, 0.50 &middot; NOT A MEASURED RATE</span>
          <span class="plate-label pc-outcome" id="pc-outcome"></span>

          <span class="plate-label pc-phase" id="pc-phase" style="bottom:14px;left:30px">01 SCORING &middot; EVERY CANDIDATE RUNS ON EVERY HIDDEN INPUT</span>
        </div>

        <p class="readout pc-readout" id="pc-readout" role="status" aria-live="off">
          <span class="pc-ro-group">
            <span>hi passes <strong id="pc-ro-hi">806</strong></span>
            <span>lo passes <strong id="pc-ro-lo">491</strong></span>
            <span>gap <strong id="pc-ro-gap">0.315</strong></span>
            <span>stratum <strong id="pc-ro-stratum">medium</strong></span>
            <span>order <strong id="pc-ro-order">hi_first</strong></span>
            <span>relation <strong id="pc-ro-rel">nested</strong></span>
          </span>
          <span class="pc-ro-group">
            <span>null = <strong>0.50</strong></span>
            <span>verdict <strong id="pc-ro-verdict">_</strong></span>
            <span>outcome <strong id="pc-ro-outcome">&mdash;</strong></span>
          </span>
        </p>

        <div class="plate-controls">
          <button type="button" class="plate-btn" id="pc-run">Run a trial</button>
          <label class="plate-slider">
            <span>Gap</span>
            <input
              type="range"
              id="pc-gap"
              min="0"
              max="800"
              step="5"
              value="315"
              aria-label="Pass-rate gap between patch A and patch B, in thousandths. Patch A is fixed at 806 of 1000."
            />
            <output id="pc-gap-out" for="pc-gap">0.315</output>
          </label>
          <button type="button" class="plate-btn pc-toggle" id="pc-orders" aria-pressed="false">Show both orders</button>
          <button type="button" class="plate-btn pc-toggle" id="pc-relation" aria-pressed="false">Nested / crossed <span class="pc-val" id="pc-relation-val">nested</span></button>
          <span class="pc-hint mono" id="pc-hint">A is fixed at 806; the slider moves B</span>
        </div>

        <figcaption class="figcap">
          <span><span class="fig-no">FIG. 1</span> — ONE TRIAL, SCHEMATIC</span>
          <span class="fig-note">Schematic of one trial. The verdict is a coin at the null (0.50), not a measured rate. A HumanEval+ task has ~972 hidden inputs; MBPP+ ~105.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="prose" data-accrete>
        <h2>Why this matters</h2>
        <p>
          Existing code-judge benchmarks label one patch <em>correct</em> and
          one <em>incorrect</em> by whether it passes an entire test suite. A
          patch passing 5 of 6 hidden tests and one passing 2 of 6 are both
          stamped &ldquo;incorrect&rdquo; and never compared. The binary label
          throws away exactly the comparison a judge is asked to make in
          practice.
        </p>
        <p>
          Judges already rank patches and filter training data, so the partial
          case is the normal case. For the human-inserted bugs PartialCredit
          starts from, the buggy program&rsquo;s median pass rate on the hidden
          inputs is 0.11 before any repair &mdash; half of the starting
          programs already pass more than a tenth of the suite.
        </p>
        <p>
          <strong>PartialCredit measures the gap directly.</strong> Two partly
          right fixes for the same task, both scored by execution on a hidden
          suite, shown blind to a judge that must pick one. Picking the fix
          that passes strictly fewer hidden inputs is an inversion. Every pair
          is shown in both orders, so a judge with no signal scores exactly
          0.50 &mdash; and the primary question is whether inversions climb as
          the two fixes get closer.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-accrete>
      <header class="section-header">
        <p class="eyebrow"><span class="bar" aria-hidden="true"></span>Method</p>
        <h2>How one trial runs</h2>
      </header>
      <ol class="steps">
        <li>
          <div>
            <h3>A repair task</h3>
            <p>
              A buggy program and a hidden suite of inputs it should satisfy.
              HumanEval+ tasks carry a median of 972 hidden inputs, MBPP+ a
              median of 105; the suites are EvalPlus&rsquo;s, pre-existing and
              human-authored. HumanEval+ bugs are HumanEvalPack&rsquo;s
              human-inserted bugs; MBPP+ bugs are freshly seeded by a model
              that is neither a generator nor a judge, and reported separately.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>Two partial patches, scored by execution</h3>
            <p>
              Small generator models propose fixes at three temperatures.
              Every candidate runs on every hidden input, twice; pass rate is
              passes over inputs. Only candidates with a pass rate strictly
              between 0 and 1 are paired, equal pass rates are never paired,
              and pairs are stratified by the gap between the two rates.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>The judge sees the specification, the buggy program, and A and B</h3>
            <p>
              Nothing else: never tests, never test output, never pass rates,
              never model names. Complete functions rather than diffs, one pair
              per call, temperature 0, one fixed prompt.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>VERDICT: A or B</h3>
            <p>
              Forced choice with no tie option; the last VERDICT line in the
              reply wins. Refusals, hedges, truncations and unparseable replies
              are excluded from the estimate and reported as answer rate.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>An inversion is picking the lower patch</h3>
            <p>
              If the judge selects the candidate that passes strictly fewer
              hidden inputs, the trial is an inversion. Whether that makes the
              judge wrong, or the suite weak, is what the manual audit decides.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>Both orders, null 0.50</h3>
            <p>
              Every pair is shown twice, hi first and lo first. A judge with no
              signal, or one that always picks the same slot, scores exactly
              0.50. That is the null for every hypothesis on this page.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-accrete>
      <header class="section-header">
        <p class="eyebrow"><span class="bar" aria-hidden="true"></span>Scope</p>
        <h2>What gets measured</h2>
      </header>
      <dl class="facts">
        <div class="fact">
          <dt>H1a</dt>
          <dd>Pooled inversion rate against 0.50, in the both-functional stratum, across the six frontier/strong judges. Interval from a task-cluster bootstrap; the Wilson interval is kept for comparison only.</dd>
        </div>
        <div class="fact">
          <dt>H1b &middot; primary</dt>
          <dd>A negative coefficient on gap: a statsmodels logit with task-clustered standard errors, and an R glmer with crossed random effects. Supported only if the 95% CI excludes zero in both.</dd>
        </div>
        <div class="fact">
          <dt>Position lock</dt>
          <dd>The same slot chosen in both orders, reported per judge alongside position consistency. A lock marginalises to exactly 0.50 and is auditable.</dd>
        </div>
        <div class="fact">
          <dt>Baselines</dt>
          <dd>Prefer-longer and prefer-shorter heuristics against the same null of 0.50; the length difference between candidates enters the model as a covariate.</dd>
        </div>
        <div class="fact">
          <dt>Design effect</dt>
          <dd>Clusters are tasks. ICC by task and by pair, task-cluster bootstrap CIs with B = 5000. The realised near-tie MDE decides pooling: strata pool only if it is at or under 10 points.</dd>
        </div>
        <div class="fact">
          <dt>Audit</dt>
          <dd>About 150 disagreement pairs, both authors labelling blind as judge_error / weak_test / ambiguous, at least 50 pairs double-labelled, Cohen&rsquo;s kappa reported.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-accrete>
      <header class="section-header">
        <p class="eyebrow"><span class="bar" aria-hidden="true"></span>Ground truth</p>
        <h2>Ground truth rules</h2>
      </header>
      <ol class="pc-rules">
        <li>Hidden tests are pre-existing and human-authored (EvalPlus). No LLM writes a grading test.</li>
        <li>No judge authored any test. Generator/judge family overlap is minimised and reported.</li>
        <li>Generators never see the hidden suite. Judges never see tests or test output.</li>
        <li>Each candidate is executed twice; unstable pass sets are dropped and the rate reported.</li>
        <li>Pass rate is a proxy for correctness. The manual audit is what turns &ldquo;judge disagreed with execution&rdquo; into &ldquo;judge was wrong&rdquo;.</li>
      </ol>
      <div class="prose pc-rules-notes">
        <p>
          <strong>Validation, 2026-09-30.</strong> The HumanEval+ canonical
          solution passes 100% of hidden inputs on 163 of 164 tasks, 0 flaky;
          the MBPP+ canonical solution on 377 of 378, 0 flaky.
        </p>
        <p>
          <strong>Exclusions.</strong> HumanEval/32 (its find_zero has many
          valid roots, so exact-output comparison is the wrong oracle), tasks
          with fewer than 20 hidden inputs, candidates whose pass sets are
          unstable across two executions (rule 4), and, by amendment 5, tasks
          whose expected-output payload exceeds 50 MB: HumanEval/15,
          HumanEval/130 and Mbpp/255.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-accrete>
      <header class="section-header">
        <p class="eyebrow"><span class="bar" aria-hidden="true"></span>Apparatus</p>
        <h2>The panel and the bank</h2>
        <p class="kicker">
          Slugs exactly as <code>configs/models.yaml</code>, in configuration
          order. Judges are never ordered by any score, and no judge family
          writes patches.
        </p>
      </header>
      <dl class="facts pc-bank">
        <div class="fact">
          <dt>Judge panel &middot; 8 judges</dt>
          <dd>
            <ul class="pc-slugs">
              {JUDGES.map((j) => (
                <li class:list={{ small: j.small }}>
                  <code>{j.slug}</code>
                  {j.note && <span class="pc-note">{j.note}</span>}
                </li>
              ))}
            </ul>
            <p class="pc-fine">The headline pools the six frontier/strong judges; the two small judges are contrast rows, reported alongside, never pooled in. Each pair &times; judge &times; both orders at temperature 0, max_tokens 6000 (Kimi 10,000); 10% of pairs &times; 3 repeats, 10% &times; 2 extra prompt variants. The preregistration counts the panel as 7 families.</p>
          </dd>
        </div>
        <div class="fact">
          <dt>Generators &middot; small models (D7)</dt>
          <dd>
            <ul class="pc-slugs">
              {GENERATORS.map((g) => (
                <li>
                  <code>{g.slug}</code>
                  {g.note && <span class="pc-note">{g.note}</span>}
                </li>
              ))}
            </ul>
            <p class="pc-fine">Decision D7: a 70B generator fixed the bugs perfectly almost every time and produced no usable pairs, so partial patches come from small instruct models at temperatures 0.2, 0.8 and 1.2. No generator family sits on the judge panel (decision D8). The pilot used the first four; the full run uses six.</p>
          </dd>
        </div>
        <div class="fact">
          <dt>Bug seeders &middot; MBPP+</dt>
          <dd>
            <ul class="pc-slugs">
              <li><code>google/gemma-3-27b-it</code><span class="pc-note">first pass</span></li>
              <li><code>amazon/nova-micro-v1</code><span class="pc-note">second pass, amendment 6</span></li>
            </ul>
            <p class="pc-fine">Neither is a generator nor a judge, so the model that writes a bug never also writes patches for it. 147 MBPP+ tasks enter the full run; 226 are dropped because even a weak model solves them every time. Chosen bugs have a median pass rate of 0.51. Seeding cost $0.17.</p>
          </dd>
        </div>
        <div class="fact">
          <dt>Datasets &middot; frozen 2026-09-30</dt>
          <dd>
            <ul class="pc-slugs">
              <li><code>HumanEval+ v0.1.10</code><span class="pc-note">164 tasks</span></li>
              <li><code>MBPP+ v0.2.0</code><span class="pc-note">378 tasks</span></li>
              <li><code>HumanEvalPack python</code><span class="pc-note">164 buggy programs</span></li>
            </ul>
            <p class="pc-fine">SHA-256 hashes in <code>data/datasets/manifest.json</code>. Hidden inputs per task: HumanEval+ median 972 (min 2, max 1000); MBPP+ median 105. Eligible for the full run: 160 HumanEval+ + 147 MBPP+ = 307 tasks.</p>
          </dd>
        </div>
        <div class="fact">
          <dt>Profiles</dt>
          <dd>
            <ul class="pc-slugs">
              <li><code>smoke</code><span class="pc-note">5 tasks, 2 generators, 1 judge, K = 1</span></li>
              <li><code>pilot</code><span class="pc-note">all eligible HumanEval+ tasks, 4 generators, 8 judges, K = 1</span></li>
              <li><code>full</code><span class="pc-note">HumanEval+ and MBPP+, 6 generators, 8 judges, K = 3</span></li>
            </ul>
            <p class="pc-fine">K is pairs per stratum per task. Sampling seed 20260922 everywhere. Every stage writes JSONL under <code>data/</code> and resumes; every API call is cached.</p>
          </dd>
        </div>
        <div class="fact">
          <dt>Gap strata &middot; |rate(A) &minus; rate(B)|</dt>
          <dd>
            <ul class="pc-slugs">
              {STRATA.map((s) => (
                <li><code>{s.name}</code><span class="pc-note">{s.range}</span></li>
              ))}
              <li><code>no-op</code><span class="pc-note">planted; reported separately, never in the headline</span></li>
            </ul>
            <p class="pc-fine">H1b lives in the first two strata. A planted no-op pairs the buggy program with a cosmetic edit against a partial candidate whose pass rate is strictly higher than the buggy program&rsquo;s.</p>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-accrete>
      <header class="section-header">
        <p class="eyebrow"><span class="bar" aria-hidden="true"></span>As of 2026-11-04</p>
        <h2>Status</h2>
        <p class="kicker">
          Repository HEAD <code>be79a73</code> of 2026-10-27; 25 commits since
          2026-09-22; one tag, <code>prereg-v1</code>. No activity after that
          commit is shown; status checked 2026-11-04.
        </p>
      </header>

      <div class="pc-status">
        <div class="pc-status-col">
          <p class="pc-status-h"><span class="pc-mark done" aria-hidden="true"></span>Done</p>
          <ul class="pc-status-list">
            <li>Datasets frozen with SHA-256 hashes (2026-09-30).</li>
            <li>Ground-truth validation on all tasks.</li>
            <li>Smoke run end to end: 5 tasks, 17 pairs, 34 judgments, $0.38.</li>
            <li>Generator probes (decision D7): small models only.</li>
            <li>Preregistration frozen 2026-10-23, tag <code>prereg-v1</code>.</li>
            <li>Pilot complete: 162 HumanEval+ tasks, 4 generators, 3,888 candidates, 348 pairs from 124 tasks (76% yield), 7,200 judgments, $45.10. Non-answer rate 1.1%.</li>
